# Target: the classic ESP32 that was "Bluetooth Proxy Bedroom"
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE only, NimBLE host. Peripheral stays enabled so the memory picture
# matches the later Matter build (commissioning uses BLE peripheral).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi + BLE coexistence on the classic ESP32
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Two OTA slots and no factory app, like ESPHome. Only used for a USB
# flash: a network install keeps the partition table already on the device.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Classic ESP32 has little IRAM: Wi-Fi + BLE + lwIP do not fit with the
# speed-optimised defaults. These move code to flash; throughput is not
# relevant here.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
