# ESP-IDF
build/
build-*/
sdkconfig
sdkconfig.c6
sdkconfig.old
managed_components/
dependencies.lock

# Host tests
test/host/build/

# Never commit flash dumps or ESPHome YAML: they contain secrets
*.bin
backups/
*.yaml.secret
secrets.yaml

.DS_Store
.vscode/

# Wi-Fi credentials, Thread dataset and HTTP token
firmware/*/main/secrets.h

# Build output captured to a file
*.log

# Release builds (contain secrets.h)
dist/

# Firmware sources copied into the add-on by tools/addon_sync.sh
# The add-on's copy of the sources: the firmware (developer mode only) is
# fetched by the add-on when needed; the generator and the examples, which
# every user needs, are committed (kept equal to the originals by the Build
# workflow)
ha-addon/matter_builder/src/components/
ha-addon/matter_builder/src/firmware/
ha-addon/matter_builder/src/LICENSE
__pycache__/
standalone/data/
